# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (Supabase free tier). Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# ClinicalTrials.gov API v2 — public, no key required, but kept configurable.
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2

# LLM provider (server-side only — never exposed to the browser)
# Supported: "gemini", "groq", or "anthropic".
#
# Primary provider: Gemini using gemini-3.5-flash-lite with native JSON schema.
# Get a key at https://aistudio.google.com/
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=<your-gemini-api-key>

# Optional fallback provider (Groq) for rate limits:
GROQ_API_KEY=<your-groq-api-key>

# Fallback generic provider key:
LLM_PROVIDER_API_KEY=<your-gemini-or-groq-api-key>

# Global cap on outbound LLM calls per rolling 60-second window, shared by
# every call the backend makes (Plan + Verify).
LLM_MAX_REQUESTS_PER_MINUTE=14

# Cost / abuse controls
MAX_REQUESTS_PER_IP_PER_HOUR=20
MAX_PATIENT_PROFILE_CHARS=4000
MAX_TRIALS_PER_QUERY=3

# Misc
APP_URL=http://localhost:3000
ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=60
