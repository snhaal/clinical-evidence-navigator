# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (Supabase free tier). Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# ClinicalTrials.gov API v2 — public, no key required, but kept configurable.
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2

# LLM provider (server-side only — never exposed to the browser)
# Supported: "anthropic", "gemini", or "groq".
#
# Groq is recommended if you're hitting rate limits on Gemini's free tier:
# 30 requests/minute vs Gemini's observed ~5, no card required, and it uses
# the standard OpenAI-compatible API (openai Python package) rather than a
# newer, more version-sensitive SDK. Get a key at console.groq.com/keys.
#
# Model choice matters here: openai/gpt-oss-120b (the default below)
# supports Groq's STRICT schema-enforced JSON output, which the batched
# Verify stage relies on for reliability. llama-3.3-70b-versatile is the
# more commonly recommended general-purpose Groq model, but does NOT
# support strict schema enforcement — the code still works with it (falls
# back to prompt-only JSON), just less reliably on large batches.
LLM_PROVIDER=groq
LLM_PROVIDER_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-120b

# Global cap on outbound LLM calls per rolling 60-second window, shared by
# every call the backend makes (Plan + Verify). This is what actually
# prevents 429 errors — check your real quota (Groq: console.groq.com,
# under Settings → Limits; Gemini: Google AI Studio) and set this a little
# under it. Groq's free tier is a documented 30 RPM as of this writing.
LLM_MAX_REQUESTS_PER_MINUTE=25

# Cost / abuse controls
MAX_REQUESTS_PER_IP_PER_HOUR=20
MAX_PATIENT_PROFILE_CHARS=4000
MAX_TRIALS_PER_QUERY=10

# Misc
APP_URL=http://localhost:3000
ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=12
